# Public site URL for magic-link redirects (optional locally; set in production if origin differs from the browser).
# Must match entries under Supabase → Authentication → URL configuration → Redirect URLs (include http://localhost:5173/auth/callback for dev).
# VITE_SITE_URL=http://localhost:5173

# Supabase — https://supabase.com/dashboard (Project Settings → API Keys)
# Used by the app and by the landing waitlist (insert + public count RPC). Same keys for local and production builds.
VITE_SUPABASE_URL=
# Use either the new publishable key (recommended) or the legacy anon JWT — not both required.
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# Optional: set VITE_ENABLE_AI=true to persist client-side tone metrics (dev heuristic)
# VITE_ENABLE_AI=false

# ZK — Semaphore proofs in-browser; server verifies via `verify-zk-proof` (see docs/technical/zk-implementation.md).
# VITE_ZK_STUB=true — fast hash-only demo (no Semaphore, no Edge verification). Safe for local dev only.
# NEVER set VITE_ZK_STUB=true for production builds; `npm run build` will fail if it is set (see vite.config.ts, docs/security/threat-model.md).
# VITE_ZK_STUB=false

# Optional: external waitlist (Typeform, Tally, etc.). When set, the landing page uses this instead of Supabase email capture.
# VITE_WAITLIST_FORM_URL=

# Optional: shown in site footer (mailto)
# VITE_CONTACT_EMAIL=

# Optional: Sentry (errors + browser tracing). Leave unset for local dev without a project.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
