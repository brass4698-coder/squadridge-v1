# Supabase — https://supabase.com/dashboard (Project Settings → API Keys)
VITE_SUPABASE_URL=
# Use either the new publishable key (recommended) or the legacy anon JWT — not both required.
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# Optional: set VITE_ENABLE_AI=true to persist client-side tone metrics (dev heuristic)
# VITE_ENABLE_AI=false

# ZK — full matrix: docs/technical/zk-implementation.md ("VITE_ZK_STUB matrix")
# - Vite dev: always local generateProof in zkAdapter (no Edge call); VITE_ZK_STUB does not change that.
# - Production build: invokes Edge Function `zk-verify` unless VITE_ZK_STUB=true (bundles local proof path).
# VITE_ZK_STUB=false

# Edge Function secrets (Dashboard → Edge Functions → zk-verify / verify-zk-proof → Secrets), not in Vite:
# ZK_DEV_SKIP_VERIFY — when not `false`, both functions use dev-shaped / stub verification paths; set `false` + Semaphore keys when wiring real verifyProof.

# Optional: external waitlist (Typeform, Tally, etc.). When set, the landing page uses this instead of Supabase email capture.
# VITE_WAITLIST_FORM_URL=

# Optional: shown in site footer (mailto)
# VITE_CONTACT_EMAIL=
