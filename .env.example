# Canonical site origin for magic-link redirects (`getSiteUrl` / `getAuthCallbackUrl`). Optional locally when you only open the app at one origin.
# Also drives the “retrieved from …” URL in Ledger sample citations when set (otherwise `window.location.origin`).
# REQUIRED for production: set to your real app URL (not a Vercel preview URL unless you intend links to hit preview).
# Preview/staging: set per deployment (e.g. Vercel env) or magic links default to that deploy’s `window.location.origin`.
# Must match Supabase → Authentication → URL configuration → Redirect URLs (e.g. http://localhost:5173/auth/callback for dev).
# VITE_SITE_URL=http://localhost:5173

# Supabase — https://supabase.com/dashboard (Project Settings → API Keys)
# Used by the app and by the landing waitlist (insert + public count RPC). Same keys for local and production builds.
VITE_SUPABASE_URL=
# Use either the new publishable key (recommended) or the legacy anon JWT — not both required.
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# --- MVP runtime policy (see src/lib/env.ts, docs/security/threat-model.md) ---
# Translation + de-escalation do not require the flags below; they only control optional persistence / real ZK.

# Optional analytics only: persists a client-side tone heuristic to sentiment_metrics (see src/lib/ai/pipeline.ts).
# Does NOT enable translation or de-escalation — those work in the browser / via Supabase without this flag.
# Leave unset or false in production unless you explicitly want sentiment_metrics rows.
# VITE_ENABLE_AI=false

# Future: optional remote tone Edge Function — see fetchRemoteToneInsight in src/lib/ai/pipeline.ts (currently no-op).
# VITE_ENABLE_REMOTE_TONE=false

# Connection debug log to IndexedDB (default: dev only).
# VITE_DEBUG_CONNECTION_LOG=false

# Developer-only demo shortcuts (Session hub "Create demo squad", intent/match helpers). Does not gate /session/demo-session-001 (offline mock is always routed in App).
# VITE_ENABLE_DEMO_SQUAD=false
# Playwright CI uses committed `.env.e2e` (placeholders + demo flag) via `npm run build:e2e` — see docs/testing.md.

# ZK — Semaphore proofs in-browser; server verifies via `verify-zk-proof` (see docs/technical/zk-implementation.md).
# Real ZK (recommended): omit this variable or set explicitly to false.
VITE_ZK_STUB=false

# Bundled demo Merkle decoys (squadridge-decoy-*) — NOT issuer-managed anonymity. Only enable for demos/staging; real pilots supply decoys via integration (see src/lib/zk/buildAnonymityGroup.ts).
# Production builds omitting this flag will throw when generating Semaphore proofs unless `decoyIdentities` are wired in via code paths.
# VITE_SEMAPHORE_DEMO_GROUP=false
# Production escape hatch for VITE_SEMAPHORE_DEMO_GROUP. Both flags must be `true` for a `mode === 'production'`
# build to ship bundled decoys (controlled internal-demo only). CI prod release jobs must NOT set this — see
# scripts/ensure-no-demo-decoys-prod.mjs and vite.config.ts.
# VITE_ALLOW_DEMO_DECOYS_IN_PROD=false
# Research only: reserved for zkTLS / web-origin proof UI experiments (see docs/technical/rfc-zktls-attribute-proofs.md).
# VITE_ZKTLS_LABS=false
# Hash-only dev placeholder — no Semaphore, no Edge (never ship; vite production build fails if true).
# VITE_ZK_STUB=true

# Optional: external waitlist (Typeform, Tally, etc.). When set, the landing page uses this instead of Supabase email capture.
# VITE_WAITLIST_FORM_URL=

# Optional: shown in site footer (mailto)
# VITE_CONTACT_EMAIL=

# Strongly recommended for production: Sentry DSN (errors + browser tracing). Builds succeed without it; reporting stays off.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/4500000000000000
# VITE_SENTRY_ENVIRONMENT=production
# Required in production whenever VITE_SENTRY_DSN is set: salt for the truncated SHA-256 of auth.users.id
# that we send as Sentry user.id (see src/lib/sentryUserHash.ts). Use a long, opaque random string;
# rotate by shipping a new value (existing Sentry events keep the old hash, new events use the new one).
# Build-time env validation refuses to ship a prod build with DSN but no salt.
# VITE_SENTRY_USER_HASH_SALT=

# Edge Functions: comma-separated browser origins allowed for CORS (e.g. ZK verify). Set in Supabase Edge secrets.
# ALLOWED_ORIGINS=http://localhost:5173,https://your-app.netlify.app
# Required on the Supabase project (Dashboard → Edge Functions → Secrets or `supabase secrets set`) for every deployed env.
# CI production deploy: set GitHub Actions secrets ALLOWED_ORIGINS, UPSTASH_* so the workflow syncs them.

# Edge `rate-limit` function: Upstash Redis REST (set on Supabase for deployed envs; when unset locally the function returns 503 and the client fails open).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Client: call Edge rate limit before matchmaking / messages / mod actions (default on). Set false to skip.
# VITE_ENABLE_EDGE_RATE_LIMIT=true

# ---------------------------------------------------------------------------
# Security & privacy middleware (server-side / Edge Function variables)
# Set these as Supabase Edge Function secrets, not in client builds.
# ---------------------------------------------------------------------------

# Request anonymization (src/middleware/anonymizeRequest.ts)
# Pepper used to HMAC-SHA-256 hash client IPs. Keep this long and opaque.
# Changing the pepper rotates all anon-IP hashes (intentional compartmentalization).
# ANON_PEPPER=

# KMS key wrapping (src/utils/encryption.ts scaffold — not yet deployed)
# The CMK reference (ARN for AWS, resource name for GCP) used to wrap data encryption keys.
# Store the actual credential in your cloud secret manager, not here.
# KMS_KEY_ID=
# KMS_PROVIDER=aws  # or gcp

# Direct Redis URL (alternative to Upstash REST for local/server-side rate limiting)
# Used by src/middleware/rateLimiter.ts RedisRateLimitStore (scaffold, not yet wired).
# For production, prefer Upstash REST (UPSTASH_REDIS_REST_URL above).
# REDIS_URL=redis://localhost:6379

# Database direct connection (for migrations, retention scripts, admin tooling only)
# Never expose to client-side code or include in Vite builds.
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
