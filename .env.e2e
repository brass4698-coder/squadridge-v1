# Used by `npm run build:e2e` (Playwright) — placeholder values only; no secrets.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=ci-placeholder-publishable-key
VITE_SUPABASE_ANON_KEY=ci-placeholder-anon-key
VITE_ZK_STUB=false
# Explicit opt-in for bundled Semaphore demo decoys — required for CI/e2e production preview proofs.
VITE_SEMAPHORE_DEMO_GROUP=true
VITE_ENABLE_DEMO_SQUAD=true
