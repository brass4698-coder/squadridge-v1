{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/protect-destructive-shell.mjs",
        "matcher": "git\\s+|supabase\\s+|rm\\s+-rf|Remove-Item",
        "failClosed": false
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/scan-prompt-secrets.mjs",
        "failClosed": false
      }
    ]
  }
}
